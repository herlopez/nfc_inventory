# Copia este archivo como .env y pon tus valores.
# El .env real NO se sube a git (está en .gitignore).

PORT=3000

# Días que dura la sesión antes de pedir la contraseña de nuevo.
SESSION_DIAS=30

# Ponlo en 1 cuando publiques con HTTPS (la cookie viaja solo cifrada).
COOKIE_SECURE=0

# Ponlo en 1 si corre detrás de un proxy/CDN (Render, Railway, Nginx).
TRUST_PROXY=0

MONEDA=USD


# --- Postgres ---
# Estas cinco no las lee la app: son para psql, pg_dump y demás herramientas.
PGHOST=mi-servidor.example.net
PGUSER=usuario
PGPASSWORD='tu-clave-aqui'
PGDATABASE=nfc
PGPORT=5432

# Esta es la que usa la app. Si la contraseña lleva caracteres especiales,
# van URL-encoded: '$' es %24, '@' es %40, ':' es %3A.
DATABASE_URL="postgresql://usuario:tu-clave-aqui@mi-servidor.example.net:5432/nfc"

# 1 si el servidor exige TLS (Neon, Supabase, RDS…). En una red privada
# tipo Tailscale se puede dejar en 0.
PGSSL=0

# Conexiones simultáneas del pool.
PG_POOL_MAX=10
